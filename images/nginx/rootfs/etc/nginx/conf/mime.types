types {
    text/html                html htm;
    text/css                 css;
    text/plain               txt;
    application/javascript   js mjs;
    application/json         json;
    application/wasm         wasm;
    application/xml          xml;
    image/svg+xml            svg;
    image/png                png;
    image/jpeg               jpeg jpg;
    image/gif                gif;
    image/webp               webp;
    image/x-icon             ico;
    font/woff                woff;
    font/woff2               woff2;
}
