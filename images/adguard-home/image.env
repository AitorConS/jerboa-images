# Read by scripts/*.sh. VERSIONS lists the newest first.
VERSIONS="0.107.79"
PLATFORMS="linux/amd64 linux/arm64"
DESCRIPTION="AdGuard Home, the network-wide ad and tracker blocking DNS server, as a Jerboa unikernel"
PORTS="3000 53/udp"
DATA=/opt/adguardhome/conf
# Its package is rebuilt from the upstream source (scripts/lib.sh).
PACKAGE_REVISION=1
